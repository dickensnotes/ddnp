---
// V1 "Refined Grid" — card for a PUBLISHED novel's working notes.
//
// Design idiom follows TeachingActivityCard.astro (tinted brand background,
// brand border, hover bg + shadow, group-hover:underline title, focus-visible
// outline ring) but keeps the manuscript photograph as the visual hook: a
// fixed 3:2 crop of the 2700x2100 source sits above the text block so every
// card in the grid is the same shape regardless of text length.
//
// Accessibility: the whole card is a single link whose heading, metadata and
// description convey the destination, so the manuscript image is decorative
// (alt=""). This mirrors the H67 rationale documented in src/pages/index.astro.
//
// `description` is rendered with set:html so novel titles can be italicized
// (e.g. <em>Little Dorrit</em>). Content is static and author-controlled.
const { title, dates, serial, description, href, img, alt = "" } = Astro.props;
---

<a
  href={href}
  class="group flex h-full w-full flex-col overflow-hidden rounded-md border border-ddnpblue bg-ddnpblue/10 no-underline transition hover:bg-ddnpblue/20 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ddnpblue"
>
  <div
    class="flex aspect-[3/2] w-full overflow-hidden border-b border-ddnpblue/60 bg-ddnptaupe/30"
  >
    <img
      src={img}
      alt={alt}
      width="2700"
      height="2100"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover object-center transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transform-none motion-reduce:transition-none"
    />
  </div>
  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <h3
      class="m-0 text-lg font-bold tracking-tight text-gray-900 group-hover:underline sm:text-xl"
    >
      <em>{title}</em>
    </h3>
    <p class="m-0 mt-1 text-sm italic text-ddnpgrey">
      {dates}<span aria-hidden="true" class="not-italic"> · </span>{serial}
    </p>
    <p
      class="m-0 mt-2 text-sm leading-snug text-gray-700"
      set:html={description}
    ></p>
  </div>
</a>
