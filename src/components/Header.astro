---
import { Icon } from "astro-icon/components";
import NavPopover from "./NavPopover.jsx";
import {
  faGears,
  faFeatherPointed,
  faBook,
  faGraduationCap,
  faPeopleGroup,
  faPenToSquare,
  faBookOpen,
  faPersonChalkboard,
} from "@fortawesome/free-solid-svg-icons";

import { Image } from "astro:assets";
import dickensLogo from "../icons/DickensNotesSide.svg";

const introductionOptions = [
  {
    name: "General Introduction",
    description: "What are the Working Notes? What is the DDNP?",
    href: "/introduction/general",
    icon: faBookOpen,
  },
  {
    name: "Scholarly Introduction",
    description:
      "Understand the significance of the Working Notes and serial process",
    href: "/introduction/scholarly",
    icon: faGraduationCap,
  },
];
const aboutOptions = [
  {
    name: "The Team",
    description: "Meet the people and institutions behind the DDNP",
    href: "/about/team",
    icon: faPeopleGroup,
  },
  {
    name: "Editing the Notes",
    description:
      "Explore our editorial, transcription, and annotation practices",
    href: "/about/editing-the-notes",
    icon: faPenToSquare,
  },
  {
    name: "Colophon/Technical",
    description: "Peek under the hood",
    href: "/about/colophon",
    icon: faGears,
  },
  {
    name: "Bibliography",
    description: "Consult additional resources about Dickens and serial form",
    href: "/about/bibliography",
    icon: faBook,
  },
];
const bookOptions = [
  {
    name: "David Copperfield (1849-50)",
    description: "",
    href: "/notes/david-copperfield",
    icon: faFeatherPointed,
  },
  {
    name: "Bleak House (1852-53)",
    description: "",
    href: "/notes/bleak-house",
    icon: faFeatherPointed,
  },
  {
    name: "Hard Times (1854)",
    description: "",
    href: "/notes/hard-times",
    icon: faFeatherPointed,
  },
  {
    name: "Little Dorrit (1855-57)",
    description: "",
    href: "/notes/little-dorrit",
    icon: faFeatherPointed,
  },
  {
    name: "Additional Working Notes",
    description: "See what's coming next",
    href: "/notes/additional-working-notes",
    icon: faFeatherPointed,
  },
];

const instructionOptions = [
  {
    name: "User Guide",
    description: "Learn how to use the DDNP",
    href: "/usage/guide",
    icon: faBook,
  },
  {
    name: "Teaching with the DDNP",
    description: "Incorporate the DDNP into your classes",
    href: "/usage/teaching",
    icon: faPersonChalkboard,
  },
];

// Note: href values here are not currently used — NavPopover receives only
// title and options, rendering a <button> (not an <a>) for each top-level item.
// URLs are kept as documentation of intent and to avoid placeholder links.
const links = [
  {
    href: "/introduction/general",
    text: "Introduction",
    options: introductionOptions,
  },
  {
    href: "/usage/guide",
    text: "Using the DDNP",
    options: instructionOptions,
  },
  {
    href: "/notes/bleak-house",
    text: "The Working Notes",
    options: bookOptions,
  },
  {
    href: "/about/team",
    text: "About the Project",
    options: aboutOptions,
  },
];
---

<script>
  const header = document.getElementById("navheader");
  const menuBtn = document.getElementById("menubtn");
  const logo = document.getElementById("navlogo");
  menuBtn.onclick = () => {
    const isOpen = header.classList.toggle("open");
    menuBtn.setAttribute("aria-expanded", isOpen.toString());
    menuBtn.querySelector(".sr-only").textContent = isOpen ? "Close main menu" : "Open main menu";
  };
  if (matchMedia("(pointer:fine)").matches) {
    logo.addEventListener("contextmenu", (event) => {
      event.preventDefault();
      window.location.href = "/";
    });
  }
</script>

<header id="navheader" class="relative z-10 bg-white border-b-2">
  <div class="bg-white text-gray-900 py-4">
    <nav
      class="relative max-w-7xl mx-auto flex items-center justify-around sm:justify-between px-4"
      aria-label="Global"
    >
      <div
        class="flex flex-col md:flex-row items-center flex-1 gap-y-6 justify-between"
      >
        <div class="flex items-center justify-between w-11/12 md:w-3/12">
          <a
            href="/"
            class="flex gap-x-1 text-gray-900 font-semibold text-xl"
            id="navlogo"
          >
            <!-- <Icon
              name="DickensNotesSide"
              height={32}
              class="-mb-1 md:h-auto md:w-36"
              aria-hidden="true"
            /> -->
            <div class="=mb-1 md:h-auto md:w-36">
              <Image
                src={dickensLogo}
                alt=""
              />
            </div>
            <span class="sr-only">Digital Dickens Notes Project</span>
          </a>
          <div class="-mr-2 sm:-mr-6 flex items-center gap-x-1 md:hidden">
            <a
              href="/search"
              aria-label="Search"
              class="rounded-md p-2 inline-flex items-center justify-center text-gray-700 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-ddnpblue"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.197 5.197a7.5 7.5 0 0 0 10.606 10.606z" />
              </svg>
            </a>
            <button
              type="button"
              id="menubtn"
              class="rounded-md p-2 inline-flex items-center justify-center hover:bg-white hover:text-gray-900 focus:outline-none focus:ring-2 focus-ring-inset focus:ring-neutral-50"
              aria-expanded="false"
              aria-controls="menu"
            >
              <span class="sr-only">Open main menu</span>
              <Icon name="menu" size={24} aria-hidden="true" />
            </button>
          </div>
        </div>
        <div
          id="menu"
          class="flex flex-col sm:flex-row gap-x-8 gap-y-4 sm:ml-10 text-center sm:text-left sm:pb-0"
        >
          {
            links.map(({ text, options }) => (
              <NavPopover title={text} options={options} client:load />
            ))
          }
          <a
            href="/search"
            aria-label="Search"
            aria-current={Astro.url.pathname === "/search" ? "page" : undefined}
            class="hidden md:inline-flex group rounded-md items-center gap-x-1 text-base font-medium text-gray-700 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-ddnpblue"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="20" height="20" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.197 5.197a7.5 7.5 0 0 0 10.606 10.606z" />
            </svg>
            <span>Search</span>
          </a>
        </div>
      </div>
    </nav>
  </div>

  <style>
    @media (max-width: 768px) {
      header:not(.open) :is(#menu) {
        @apply hidden;
      }
      header.open {
        @apply bg-white;
      }
    }
  </style>
</header>
