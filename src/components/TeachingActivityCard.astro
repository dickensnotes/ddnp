---
// A card linking to a teaching assignment/activity subpage. The visual shell
// lives in ThumbnailCard.astro (shared with the homepage novel cards); this
// wrapper maps the contributor credit onto the shell's meta line so
// TeachingActivities.astro can keep its existing data shape.
import ThumbnailCard from "./ThumbnailCard.astro";

const { contributor, ...rest } = Astro.props;
---

<ThumbnailCard {...rest} meta={contributor} />
