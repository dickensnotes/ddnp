---
// Homepage card for one working notes edition (see src/data/novels.js).
// The visual shell lives in ThumbnailCard.astro, shared with the teaching
// activity cards. Published editions link to their notes page; forthcoming
// editions render as a non-link card with the release date in the meta line.
import ThumbnailCard from "./ThumbnailCard.astro";

const { novel } = Astro.props;
const published = novel.status === "published";
---

<ThumbnailCard
  href={published ? novel.href : undefined}
  img={novel.thumbnail}
  title={`<i>${novel.title}</i>`}
  meta={published ? novel.dates : `${novel.dates} · Edition due ${novel.release}`}
  description={novel.description}
  variant={published ? "default" : "forthcoming"}
/>
