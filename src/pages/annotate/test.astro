---
import MiradorFullScreenLayout from "../../layouts/mirador-full-screen-layout.astro";
import AnnotationEditorTest from "../../components/AnnotationEditorTest";

// Unlisted test page for the Mirador Annotation Editor.
// Not linked from the nav. Reads and saves annotations on the mae-poc branch
// of dickens-annotations (with a GitHub token); never the published ones.
const manifest =
  "https://dickensnotes.github.io/dickens-annotations/img/derivatives/iiif/davidcopperfieldtranscription/manifest.json";
---

<MiradorFullScreenLayout
  title="Annotation editor test"
  description="Mirador Annotation Editor test"
>
  <AnnotationEditorTest client:only="react" loadedManifest={manifest} />
</MiradorFullScreenLayout>
