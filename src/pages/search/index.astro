---
import MainHead from "../../components/MainHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SearchPage from "../../components/search/SearchPage.jsx";

const title = "Search the DDNP";
const description =
  "Search the Working Notes, annotations, and content of the Digital Dickens Notes Project.";
---

<html lang="en">
  <head>
    <MainHead title={title} description={description} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-T6K5MX5Y23"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-T6K5MX5Y23");
    </script>
  </head>

  <body class="container mx-auto flex flex-col h-screen justify-between">
    <Header />
    <main class="flex-auto px-4 sm:px-6 py-6">
      <h1 class="text-4xl font-bold mb-4">{title}</h1>
      <p class="text-gray-700 mb-6">
        The DDNP's search tool will display results for keywords found in the
        Working Notes, in the Annotations for each set of Notes, and in the
        Site Content. Search results can be filtered according to these
        categories using the "Content Type" list on the left of the results
        page.
      </p>
      <SearchPage client:load />
    </main>
    <Footer />
  </body>
</html>
