---
// Component Imports
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import MainHead from "../components/MainHead.astro";
import NovelCard from "../components/NovelCard.astro";
import SkipLink from "../components/SkipLink.astro";
import { novels } from "../data/novels.js";

// Alt text pattern for card thumbnails: use alt="" (empty/decorative).
// Each thumbnail sits beside a heading (<h3>) and description (<p>) inside the
// same link, so the image is decorative in context. Using a descriptive alt
// would cause screen readers to announce the image text and then immediately
// re-read the link text — a redundant double-announcement.
// See WCAG technique H67 and ThumbnailCard.astro for the full link structure.

// Published editions first, then forthcoming. Array.prototype.sort is stable,
// so each group keeps the chronological order from novels.js.
const orderedNovels = [...novels].sort(
  (a, b) => (a.status === "published" ? 0 : 1) - (b.status === "published" ? 0 : 1),
);
---

<html lang="en">
  <head>
    <MainHead
      title="Dickens Notes"
      description="The Dickens Notes project explores serial form with Charles Dickens's working notes"
    />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-T6K5MX5Y23"
    ></script><script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-T6K5MX5Y23");
    </script></head
  >

  <!-- Google tag (gtag.js) -->

  <body class="container mx-auto">
    <SkipLink />
    <Header />
    <main id="main-content">
      <Hero />
      <section
        aria-labelledby="working-notes-heading"
        class="mt-12 px-4 sm:px-6"
      >
        <h2
          id="working-notes-heading"
          class="m-0 text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl"
        >
          The Working Notes
        </h2>
        <ul role="list" class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
          {
            orderedNovels.map((novel) => (
              <li class="grid">
                <NovelCard novel={novel} />
              </li>
            ))
          }
        </ul>
        <p class="mt-6">
          <a
            href="/notes/additional-working-notes"
            class="font-semibold text-gray-900 underline decoration-ddnpblue underline-offset-4 hover:decoration-2"
          >
            More about the forthcoming editions →
          </a>
        </p>
      </section>
    </main>
    <Footer />
  </body>
</html>
