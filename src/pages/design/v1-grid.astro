---
// DESIGN PREVIEW — homepage novel-card variant V1, "Refined Grid".
// A standalone copy of the homepage; the real homepage (src/pages/index.astro)
// is untouched. The Google Analytics tag is deliberately omitted on preview
// pages.
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import MainHead from "../../components/MainHead.astro";
import SkipLink from "../../components/SkipLink.astro";
import GridForthcomingCard from "../../components/homepage-variants/GridForthcomingCard.astro";
import GridNovelCard from "../../components/homepage-variants/GridNovelCard.astro";

// Alt text pattern for the manuscript images: alt="" (empty/decorative).
// Each image sits inside a link that already carries a title (<h3>), a
// dates/serial-form line and a description, so a descriptive alt would cause
// screen readers to announce the image text and then immediately re-read the
// link text. See WCAG technique H67 and src/pages/index.astro.
//
// Descriptions are the homepage copy with the repeated closing clause ("...
// through our introduction and annotations to these notes") lifted out: at
// three cards per row that phrase appeared four times in one eyeful. It is
// now stated once, in the section intro below.
const published = [
  {
    title: "David Copperfield",
    dates: "1849–50",
    serial: "19 monthly numbers",
    description:
      "Immerse yourself in the composition of Dickens's most autobiographical novel.",
    href: "/notes/david-copperfield",
    img: "/images/home/david-copperfield-wn-7-card.webp",
    alt: "",
  },
  {
    title: "Bleak House",
    dates: "1852–53",
    serial: "19 monthly numbers",
    description: "Explore Dickens's management of the novel's dual narrators.",
    href: "/notes/bleak-house",
    img: "/images/home/bleak-house-wn-15-card.webp",
    alt: "",
  },
  {
    title: "Hard Times",
    dates: "1854",
    serial: "20 weekly parts",
    description:
      "Follow Dickens's difficulties navigating a weekly serial rather than a monthly one.",
    href: "/notes/hard-times",
    img: "/images/home/hard-times-wn-02-card.webp",
    alt: "",
  },
  {
    title: "Little Dorrit",
    dates: "1855–57",
    serial: "19 monthly numbers",
    description:
      "Discover how Dickens's idea for <em>Nobody's Fault</em> transformed into <em>Little Dorrit</em>.",
    href: "/notes/little-dorrit",
    img: "/images/home/little-dorrit-wn-04-card.webp",
    alt: "",
  },
];

// Working notes survive for these novels but are not yet published on the
// site. `siglum` is the ornamental monogram shown in place of a photograph.
const forthcoming = [
  {
    title: "Martin Chuzzlewit",
    dates: "1843–44",
    serial: "20 monthly numbers",
    siglum: "MC",
  },
  {
    title: "Dombey and Son",
    dates: "1846–48",
    serial: "20 monthly numbers",
    siglum: "DS",
  },
  {
    title: "Our Mutual Friend",
    dates: "1864–65",
    serial: "20 monthly numbers",
    siglum: "OMF",
  },
  {
    title: "The Mystery of Edwin Drood",
    dates: "1870",
    serial: "unfinished, monthly numbers",
    siglum: "ED",
  },
];
---

<html lang="en">
  <head>
    <MainHead
      title="Design preview: Refined Grid"
      description="Design preview of a homepage novel-card layout for the Dickens Notes project"
    />
  </head>

  <body class="container mx-auto">
    <SkipLink />
    <Header />
    <main id="main-content">
      <Hero />
      <section
        aria-labelledby="working-notes-heading"
        class="mt-12 px-4 sm:px-6"
      >
        <div class="max-w-3xl">
          <h2
            id="working-notes-heading"
            class="m-0 text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl"
          >
            The Working Notes
          </h2>
          <p class="mt-3 leading-snug text-gray-700">
            Each novel below opens onto an introduction, faithful transcriptions
            of Dickens's notes, and editorial annotations. Four are online now;
            four more are in preparation.
          </p>
        </div>

        <ul
          role="list"
          class="mt-8 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3"
        >
          {
            published.map((novel) => (
              <li class="flex">
                <GridNovelCard {...novel} />
              </li>
            ))
          }
          {
            forthcoming.map((novel) => (
              <li class="flex">
                <GridForthcomingCard {...novel} />
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
